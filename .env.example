# ==============================================================================
# ProuDig — Umgebungsvariablen (Vorlage)
#
# Kopie als `.env` neben docker-compose.yml anlegen und Werte setzen.
# `.env` ist gitignored — NIEMALS echte Secrets committen.
# Auf dem Server wird `.env` beim Deploy aus Ansible Vault gerendert (siehe
# deploy/ansible/group_vars/all/vault.yml + deploy/ansible/CUTOVER.md); `deploy.sh`
# erzeugt keine Secrets mehr. Diese Datei dient nur der Doku der Variablennamen.
# ==============================================================================

# ---------- Portal-App / DB ----------
DB_USER=proudig
DB_PASSWORD=change-me
PREVIEW_PASSWORD=change-me

# ---------- Keycloak (auth.proudig.ai) ----------
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# Öffentliche URL inkl. Schema (TLS terminiert an Caddy).
KEYCLOAK_HOSTNAME=https://auth.proudig.ai

# ---------- NextCloud (files.proudig.ai) ----------
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_DB_PASSWORD=change-me
NEXTCLOUD_REDIS_PASSWORD=change-me
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change-me
# Kommagetrennte Liste erlaubter Hostnamen.
NEXTCLOUD_TRUSTED_DOMAINS=files.proudig.ai
NEXTCLOUD_OVERWRITECLIURL=https://files.proudig.ai
