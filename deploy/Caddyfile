# ==============================================================================
# Caddyfile - ProuDig Reverse Proxy Konfiguration
#
# AKTIV: Domain-basierter HTTPS-Zugriff für proudig.ai
# Automatisches Let's Encrypt Zertifikat.
# ==============================================================================

# ==============================================================================
# HTTPS-Zugriff für proudig.ai
# ==============================================================================
# Automatisches Let's Encrypt Zertifikat für proudig.ai und www.proudig.ai.
# HTTP wird automatisch auf HTTPS umgeleitet.
# Zugriff über: https://proudig.ai/ oder https://www.proudig.ai/

proudig.ai, www.proudig.ai {
    reverse_proxy proudig-app:8081

    # Security Headers
    header {
        # Content-Security-Policy
        # React/Vite benötigt unsafe-eval (Babel JSX Transform)
        # Bootstrap Icons lokal gebündelt (npm package)
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self';"

        # Zusätzliche Security Headers
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"

        # HSTS
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    }

    # Logging
    log {
        output stdout
        format console
    }
}

# ==============================================================================
# HTTPS-Zugriff für files.proudig.ai (NextCloud)
# ==============================================================================
# Eigene Subdomain, damit NextCloud in Frames laufen darf (kein DENY hier) und
# der strikte proudig.ai-Block unberührt bleibt. TLS terminiert hier, intern HTTP.

files.proudig.ai {
    reverse_proxy nextcloud:80

    # NextCloud-Service-Discovery: well-known CalDAV/CardDAV/Webfinger umleiten
    # (verhindert Admin-Warnungen).
    redir /.well-known/carddav /remote.php/dav 301
    redir /.well-known/caldav /remote.php/dav 301
    redir /.well-known/webfinger /index.php/.well-known/webfinger 301
    redir /.well-known/nodeinfo /index.php/.well-known/nodeinfo 301

    header {
        # KEIN X-Frame-Options: DENY — NextCloud setzt eigene Header (SAMEORIGIN).
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }

    log {
        output stdout
        format console
    }
}

# ==============================================================================
# HTTPS-Zugriff für auth.proudig.ai (Keycloak)
# ==============================================================================
# TLS terminiert hier; Caddy setzt X-Forwarded-*, passend zu KC_PROXY_HEADERS.

auth.proudig.ai {
    reverse_proxy keycloak:8080

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }

    log {
        output stdout
        format console
    }
}

# ==============================================================================
# FALLBACK: IP-basierter HTTP-Zugriff (für Tests ohne Domain)
# ==============================================================================
