# ProuDig Environment (generiert von Ansible aus group_vars + Vault)
DB_USER={{ db_user }}
DB_PASSWORD={{ db_password }}
PREVIEW_PASSWORD={{ preview_password }}

# Keycloak (auth.proudig.ai)
KEYCLOAK_DB_USER={{ keycloak_db_user }}
KEYCLOAK_DB_PASSWORD={{ keycloak_db_password }}
KEYCLOAK_ADMIN={{ keycloak_admin }}
KEYCLOAK_ADMIN_PASSWORD={{ keycloak_admin_password }}
KEYCLOAK_HOSTNAME={{ keycloak_hostname }}

# NextCloud (files.proudig.ai)
NEXTCLOUD_DB_USER={{ nextcloud_db_user }}
NEXTCLOUD_DB_PASSWORD={{ nextcloud_db_password }}
NEXTCLOUD_REDIS_PASSWORD={{ nextcloud_redis_password }}
NEXTCLOUD_ADMIN_USER={{ nextcloud_admin_user }}
NEXTCLOUD_ADMIN_PASSWORD={{ nextcloud_admin_password }}
NEXTCLOUD_TRUSTED_DOMAINS={{ nextcloud_trusted_domains }}
NEXTCLOUD_OVERWRITECLIURL={{ nextcloud_overwritecliurl }}
