<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="018-create-external-share-links" author="ProuDig">
        <createTable tableName="external_share_links">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="token" type="VARCHAR(64)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="document_id" type="VARCHAR(36)"/>
            <column name="folder_id" type="VARCHAR(36)"/>
            <column name="permission" type="VARCHAR(20)" defaultValue="DOWNLOAD">
                <constraints nullable="false"/>
            </column>
            <column name="password_hash" type="VARCHAR(100)"/>
            <column name="expires_at" type="TIMESTAMP"/>
            <column name="recipient_email" type="VARCHAR(255)"/>
            <column name="revoked" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_accessed_at" type="TIMESTAMP"/>
            <column name="access_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="external_share_links" baseColumnNames="document_id"
                                 constraintName="fk_share_link_document" referencedTableName="documents"
                                 referencedColumnNames="id" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="external_share_links" baseColumnNames="folder_id"
                                 constraintName="fk_share_link_folder" referencedTableName="folders"
                                 referencedColumnNames="id" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="external_share_links" baseColumnNames="created_by"
                                 constraintName="fk_share_link_created_by" referencedTableName="users"
                                 referencedColumnNames="id"/>
        <createIndex tableName="external_share_links" indexName="idx_share_link_token">
            <column name="token"/>
        </createIndex>
    </changeSet>

    <!-- Altes User-zu-User-Sharing abgelöst (0 Bestandsfreigaben) -->
    <changeSet id="018-drop-document-shares" author="ProuDig">
        <dropTable tableName="document_shares"/>
    </changeSet>

</databaseChangeLog>
